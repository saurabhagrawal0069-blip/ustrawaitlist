# Supabase project settings (required for live registrations)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets: never expose these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=USTRA <hello@yourdomain.com>
# Optional. Email address that gets a message when a new device opens the landing page.
ADMIN_NOTIFY_EMAIL=you@example.com
WHATSAPP_ACCESS_TOKEN=YOUR_META_CLOUD_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_TEMPLATE_CUSTOMER=ustra_customer_waitlist
WHATSAPP_TEMPLATE_BUSINESS=ustra_business_waitlist
WHATSAPP_TEMPLATE_LANGUAGE=en
# Required. Any long random text. Used to hash visitor IP addresses for rate limiting.
IP_HASH_SALT=CHANGE_TO_A_LONG_RANDOM_STRING
